# Optional: leave these empty for local-only mode; the app will not contact Convex.
# `pnpm exec convex dev --once` (or `pnpm convex:dev`) writes the deployment
# identifier and public URLs to .env.local. OAuth and JWT secrets do not belong here.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional comma-separated host patterns accepted by the Next.js dev server.
# Example: *.example-tailnet.ts.net
NEXT_ALLOWED_DEV_ORIGINS=
