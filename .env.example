# Required. `pnpm exec convex dev --once` writes development values to .env.local.
# Preview and production must use their own Convex deployments and exact URLs.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Exact public origin for OAuth issuer/resource metadata and Host validation.
MCP_ISSUER=https://your-app.example
# Native MCP clients omit Origin. Add only explicit browser-client origins here.
MCP_ALLOWED_ORIGINS=

# Configure email values as Convex Project Settings defaults for development and preview,
# never in this public file. Defaults affect newly created deployments only;
# backfill existing deployments once and update defaults plus active deployments
# whenever credentials rotate:
# Development default only; hosted preview provisioning must set its dynamic origin.
# SITE_URL=http://localhost:3000
# AUTH_RESEND_KEY=shared-non-production-sending-key
# AUTH_EMAIL_FROM=Study Planner <login@auth.example.com>
# AUTH_EMAIL_MODE=preview
# Optional comma-separated exact addresses and whole domains, e.g.
# AUTH_EMAIL_ALLOWED_RECIPIENTS=alice@example.com,example.org,@partner.net
# Production uses distinct Resend credentials and AUTH_EMAIL_MODE=production.
# Set JWT_PRIVATE_KEY and JWKS independently on every deployment; never share them
# through project defaults. Vercel environment variables do not configure Convex.
# Retained GitHub accounts only, until migration is complete:
# AUTH_GITHUB_MIGRATION_ENABLED=true, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET

# Optional comma-separated host patterns accepted by the Next.js dev server.
# Example: *.example-tailnet.ts.net
NEXT_ALLOWED_DEV_ORIGINS=
