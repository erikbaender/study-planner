# Required. `pnpm exec convex dev --once` writes development values to .env.local.
# Preview and production must use their own Convex deployments and exact URLs.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Exact public origin for OAuth issuer/resource metadata and Host validation.
MCP_ISSUER=https://your-app.example
# Native MCP clients omit Origin. Add only explicit browser-client origins here.
MCP_ALLOWED_ORIGINS=

# Set these with `convex env set` on each deployment, never in this public file:
# SITE_URL=https://the-exact-study-planner-origin.example
# AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, JWT_PRIVATE_KEY, and JWKS

# Optional comma-separated host patterns accepted by the Next.js dev server.
# Example: *.example-tailnet.ts.net
NEXT_ALLOWED_DEV_ORIGINS=
